&lt;p&gt;&lt;img alt=&#34;Image&#34; loading=&#34;lazy&#34; src=&#34;https://images.openai.com/static-rsc-4/iZ8OFspW2pkrhstHIBE0p0dXc5NGS8q8OZG9dSNPt5Eq6aDE2iCzLx-rWAGwhdufzkzGnMQdtTQsLsY-0palfxatwkr73LZeeScc3a1LtEG7s7NeL5CFZo8-_8FDUaBi6OJgshFhcz7HY-WFnYx2ssDEXZgcPMSGuQGf3bhFBJMo2310Vo1dPRZUR9WC-29Z?purpose=fullsize&#34;&gt;&lt;/p&gt;
