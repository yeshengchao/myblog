&lt;p&gt;&lt;img alt=&#34;Image&#34; loading=&#34;lazy&#34; src=&#34;https://images.openai.com/static-rsc-4/u89XER4d0eEMtQv0szk1chMh2KihQwJlVov243OO5iEIpzqXGFB-pwbkQdh5D626dmwXjvQtqzuDQ5L0kPPS8FHGDn1n1RQ6P5gT1y7m--2D1bo25Q7J-P3Er4Fq2eEpXv11XUW44rZcVQ2PYHj51EKJy_qIvUJ0C6wembOFdmlsMT-00fBV1GH2VS1b6yx1?purpose=fullsize&#34;&gt;&lt;/p&gt;
