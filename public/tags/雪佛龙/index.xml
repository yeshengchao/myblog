&lt;p&gt;&lt;img alt=&#34;Image&#34; loading=&#34;lazy&#34; src=&#34;https://images.openai.com/static-rsc-4/eJdnUiWNYEnmgDkL_0-FSx9thlPad-W0cNC0tgHtQNvL43szUfH2heKdHdnrqdqqPju6VuiUH-PWMrTjTqqkgwd3Sm50r8vOmVuse5gmNaJCNO89mnjf24Q9b8e1QQNaHMaUfnppqDlTCjp0PqsrVKlxxHj9Kko2w6oBWq3GQqR7qqC9TSQNLhkFsAcjA118?purpose=fullsize&#34;&gt;&lt;/p&gt;
