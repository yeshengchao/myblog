&lt;p&gt;&lt;img alt=&#34;Image&#34; loading=&#34;lazy&#34; src=&#34;https://images.openai.com/static-rsc-4/dB0nO5Qz8b79ZpWxKa2RijZA2NC2r0iOMSoI3tAnc6AqZfjsLLW_C9tmToubdQ0VS8VzTKJRsO5I695hlpjmzJDg78yYDTJ4ihTaKZ9_AD5_GcX5F8vIWkzuWfjB4GtdzdQHDiDPO57-eHD4UR3u0Blw8XlLS0ktFoBUnDHG0W8xn4iIb5i-8EhhK-8aV5ic?purpose=fullsize&#34;&gt;&lt;/p&gt;
